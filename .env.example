# Copy to .env and adjust. All values are optional.

# Local LLM (Ollama) used for the "Why you'll like it" notes
LLM_ENABLED=true
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
LLM_TIMEOUT_SECONDS=90

# Book covers from Open Library (they ask for a contact email in the User-Agent)
COVERS_ENABLED=true
CONTACT_EMAIL=you@example.com

# Ratings on the book page (Google Books + Open Library).
# A free Google API key with the Books API enabled raises Google's request limit.
RATINGS_ENABLED=true
GOOGLE_BOOKS_API_KEY=

# Embedding model (changing it rebuilds the index automatically)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Allowed browser origins when the frontend runs on a different port/domain
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173